# ==========================================================
# PIXEL NOVA — REMOTE BRAIN ENVIRONMENT TEMPLATE
# ==========================================================

# Google Gemini API Key (Required for Gemini VLM reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

PORT=8000
HOST=127.0.0.1

# ==========================================================
# MULTI-TIER INFERENCE PROVIDER CONFIGURATION
# ==========================================================
# Options for VLM_PROVIDER: "gemini" | "vllm" | "ollama"
VLM_PROVIDER=gemini

# Primary Gemini Model
GEMINI_MODEL=gemini-1.5-flash

# ==========================================================
# OPEN-WEIGHTS VLM CONFIGURATION (vLLM / Ollama)
# Supported Models:
#   1. Qwen/Qwen3-VL-7B-Instruct (Latest Flagship Vision UI Agent)
#   2. Qwen/Qwen2.5-VL-7B-Instruct (Browser Grounding Specialist)
#   3. Qwen/Qwen3.8-Flash (High-Throughput Reasoning Planner)
#   4. meta-llama/Llama-3.2-11B-Vision-Instruct (Meta Premier VLM)
#   5. microsoft/Phi-3.5-vision-instruct (Compact Edge Server 4B)
# ==========================================================
OPENAI_COMPATIBLE_BASE_URL=http://localhost:8000/v1
OPENAI_COMPATIBLE_MODEL=Qwen/Qwen3-VL-7B-Instruct
OPENAI_COMPATIBLE_API_KEY=EMPTY
